      <Ellipse Canvas.Left="3.75in" Canvas.Top="4.71in" Width="0.13in" Height="0.13in" Fill="@accent2"/>
      <Ellipse Canvas.Left="6.6in" Canvas.Top="4.71in" Width="0.13in" Height="0.13in" Fill="@accent3"/>
      <Ellipse Canvas.Left="9.45in" Canvas.Top="4.71in" Width="0.13in" Height="0.13in" Fill="@accent4"/>

      <TextBlock Canvas.Left="0.9in" Canvas.Top="4.1in" Width="2.5in" FontSize="11" FontWeight="Bold" Foreground="@accent1" LetterSpacing="2">2027 Q1</TextBlock>
      <TextBlock Canvas.Left="0.9in" Canvas.Top="5.05in" Width="2.5in" FontSize="20" FontWeight="Bold" Foreground="#F2F5FF">开放预览</TextBlock>
      <TextBlock Canvas.Left="0.9in" Canvas.Top="5.55in" Width="2.7in" Style="body">50 家设计伙伴，语义层 v1</TextBlock>

      <TextBlock Canvas.Left="3.75in" Canvas.Top="4.1in" Width="2.5in" FontSize="11" FontWeight="Bold" Foreground="@accent2" LetterSpacing="2">2027 Q2</TextBlock>
      <TextBlock Canvas.Left="3.75in" Canvas.Top="5.05in" Width="2.5in" FontSize="20" FontWeight="Bold" Foreground="#F2F5FF">公共 Beta</TextBlock>
      <TextBlock Canvas.Left="3.75in" Canvas.Top="5.55in" Width="2.7in" Style="body">图表、叙事、导出全打通</TextBlock>

      <TextBlock Canvas.Left="6.6in" Canvas.Top="4.1in" Width="2.5in" FontSize="11" FontWeight="Bold" Foreground="@accent3" LetterSpacing="2">2027 Q3</TextBlock>
      <TextBlock Canvas.Left="6.6in" Canvas.Top="5.05in" Width="2.5in" FontSize="20" FontWeight="Bold" Foreground="#F2F5FF">团队空间</TextBlock>
      <TextBlock Canvas.Left="6.6in" Canvas.Top="5.55in" Width="2.7in" Style="body">评论、版本与发布流上线</TextBlock>

      <TextBlock Canvas.Left="9.45in" Canvas.Top="4.1in" Width="2.5in" FontSize="11" FontWeight="Bold" Foreground="@accent4" LetterSpacing="2">2027 Q4</TextBlock>
      <TextBlock Canvas.Left="9.45in" Canvas.Top="5.05in" Width="2.5in" FontSize="20" FontWeight="Bold" Foreground="#F2F5FF">生态</TextBlock>
      <TextBlock Canvas.Left="9.45in" Canvas.Top="5.55in" Width="2.7in" Style="body">插件市场与开放 API</TextBlock>
      <TextBlock Canvas.Left="0.9in" Canvas.Top="6.65in" Width="10in" Style="caption">每季度末复核一次，未达标不进入下一阶段。</TextBlock>
    </Canvas>
  </Slide>

